# ===================== LLM 配置 =====================
# mock = 内置演示客户端（无 Key 可跑通完整多轮 Reflection）
# real = 真实 OpenAI 兼容接口（失败自动降级回 mock）
HARNESS_LLM_MODE=mock
OPENAI_API_KEY=sk-kimi-S5P1eaqjo6HetQwRTCwoqjoCqWE8rNuM09egrfdoy4LjWoy86LUSKXO6YiQy4Q0E
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_MODEL=k3
HARNESS_LLM_TIMEOUT_S=30
# 采样温度；留空 = 不传递该参数（部分模型如 k3 只允许 temperature=1，留空最兼容）
HARNESS_LLM_TEMPERATURE=

# ===================== Embedding 配置 =====================
# 优先加载本地缓存的 BGE；缓存不存在时自动降级为 TF-IDF 检索
HARNESS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 1 = 仅使用本地缓存（离线安全）；0 = 允许联网下载权重
HARNESS_EMBEDDING_OFFLINE=1

# ===================== Harness 阈值 =====================
HARNESS_MAX_REFLECTION_ROUNDS=2
HARNESS_LENGTH_TOLERANCE=0.15
HARNESS_SEMANTIC_SIM_THRESHOLD=0.70
HARNESS_LLM_MECH_MAX=0.30
HARNESS_LLM_FIDELITY_MIN=0.70
HARNESS_MAX_PARAGRAPHS=20
HARNESS_MAX_CHARS_PER_PARAGRAPH=6000
HARNESS_MAX_TOTAL_CHARS=40000

# ===================== 成本估算（每 1K token，单位 USD） =====================
HARNESS_PRICE_INPUT_PER_1K=0.00015
HARNESS_PRICE_OUTPUT_PER_1K=0.0006

# ===================== 检索 =====================
HARNESS_TOP_K_TERMS=8
HARNESS_TOP_K_EXPERIENCES=2
